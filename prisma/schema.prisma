// Prisma Schema for Lalita Kapilavai Portfolio & Cultural Archive Platform
// Configured with PostgreSQL 17, pgvector, RBAC, Dynamic Layouts & Cultural Graph

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// RBAC & Better-Auth Models
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(ADMIN)
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// -----------------------------------------------------------------------------
// Global System Configuration & Storage
// -----------------------------------------------------------------------------

model SystemSetting {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteName          String   @default("Lalita Kapilavai — Sacred Art & Carnatic Music Archive")
  siteDescription   String?  @db.Text
  adminAlertEmail   String   @default("admin@lalitakapilavai.com")
  contactEmail      String?
  contactPhone      String?
  
  // Watermark parameters
  watermarkText     String   @default("© Lalita Kapilavai - Sacred Art & Heritage")
  watermarkOpacity  Float    @default(0.4)
  watermarkFontSize Int      @default(32)
  watermarkStyle    String?  @default("REPEAT_DIAGONAL") // REPEAT_DIAGONAL, BANNER, CORNER, BOTH

  // Cloudflare R2 / AWS S3 storage settings
  storageProvider   String   @default("R2") // R2, S3, CUSTOM
  r2AccountId       String?
  r2BucketName      String?  @default("lalitakapilavai-media")
  r2PublicUrl       String?  @default("https://media.lalitakapilavai.com")
  s3Region          String?  @default("ap-south-1")
  s3BucketName      String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3PublicUrl       String?
  
  // Localization defaults
  defaultCurrency   String   @default("INR")
  defaultTimezone   String   @default("Asia/Kolkata")

  instagramUrl      String?
  youtubeUrl        String?
  facebookUrl       String?
  pinterestUrl      String?
  // Branding
  logoUrl           String?
  faviconUrl        String?

  // Dynamic Footer, Email/Gmail SMTP & Multi-Provider AI Configuration
  footerConfig      Json?
  emailConfig       Json?
  aiConfig          Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// Dynamic Navigation (Menu Items)
// -----------------------------------------------------------------------------

enum MenuPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  SIDEBAR_LEFT
  DRAWER_RIGHT
}

model MenuItem {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label        String
  path         String
  position     MenuPosition  @default(TOP_CENTER)
  orderIndex   Int           @default(0)
  isActive     Boolean       @default(true)
  openInNewTab Boolean       @default(false)
  iconName     String?

  // Self-referencing hierarchy supporting up to 2 nested sub-menu tiers
  parentId     String?       @db.Uuid
  parent       MenuItem?     @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]    @relation("MenuHierarchy")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("menu_items")
}

// -----------------------------------------------------------------------------
// Dynamic Page Layout Engine (12-Column Responsive Grid)
// -----------------------------------------------------------------------------

model Page {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  slug            String        @unique
  metaDescription String?       @db.Text
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections        PageSection[]

  @@map("pages")
}

model PageSection {
  id                       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pageId                   String        @db.Uuid
  title                    String?
  slug                     String?
  orderIndex               Int           @default(0)
  gridSpan                 Int           @default(12) // 1 to 12 responsive grid span
  backgroundColor          String?
  backgroundType           String?       @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?        @default(0.5)
  customCssClass           String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  page                     Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  subSections              SubSection[]

  @@map("page_sections")
}

model SubSection {
  id                       String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sectionId                String      @db.Uuid
  title                    String?
  orderIndex               Int         @default(0)
  gridSpan                 Int         @default(12) // 1 to 12 responsive grid span
  content                  Json        // Rich block JSON content
  backgroundType           String?     @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?      @default(0.5)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  section                  PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("sub_sections")
}

// -----------------------------------------------------------------------------
// Artwork Catalog, Categories & Exhibitions
// -----------------------------------------------------------------------------

model ArtCategory {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String    @unique // Tanjore, Mysore, Pahari, Pichwai, Kalamkari, Cheriyal, Miscellaneous
  slug           String    @unique
  description    String?   @db.Text
  coverImage     String?
  displayOrder   Int       @default(0)

  // Configurable Hero Banner Elements
  badgeLabel     String?   @default("Traditional Fine Art School")
  heroTitle      String?   // Defaults to category name if null
  curatorialNote String?   @db.Text // Rich Tiptap HTML content

  // Banner Styling Configurations
  bannerHeight   Int?      @default(360) // in pixels
  overlayOpacity Float?    @default(0.45) // 0.0 to 1.0
  imagePosition  String?   @default("center") // "center" | "top" | "bottom"
  borderStyle    String?   @default("gold-fillet") // "none" | "gold-fillet" | "subtle"

  // Self-referencing Parent-Child relationship
  parentId       String?       @db.Uuid
  parent         ArtCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ArtCategory[] @relation("CategoryHierarchy")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artworks       Artwork[]

  @@map("art_categories")
}

model Artwork {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String               @unique
  description        String               @db.Text
  categoryId         String               @db.Uuid
  dimensions         String               // e.g. "36 x 48 inches"
  medium             String               // e.g. "22k Gold Foil, Teakwood, Semi-Precious Gemstones"
  yearCreated        Int
  hasGoldFoil        Boolean              @default(false)
  goldPurity         String?              // e.g. "22 Carat Jaipur Gold Leaf"
  price              Decimal?             @db.Decimal(12, 2)
  currency           String               @default("INR")
  isAvailable        Boolean              @default(true)
  isFeatured         Boolean              @default(false)
  primaryImageUrl    String
  watermarkedWebpUrl String
  protectedS3Key     String?              // Protected original master S3 key
  qrCodeUrl          String?              // Generated high-res Exhibition Floor QR code URL
  
  // 1536-dimensional embedding for pgvector visual similarity
  embedding          Unsupported("vector(1536)")?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  category           ArtCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events             ArtworkOnEvent[]
  leads              Lead[]
  ragaLinks          ArtworkRagaLink[]
  eCatalogItems      ECatalogItem[]

  @@map("artworks")
}

model ArtworkOnEvent {
  artworkId    String   @db.Uuid
  eventId      String   @db.Uuid
  displayOrder Int      @default(0)

  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([artworkId, eventId])
  @@map("artworks_on_events")
}

// -----------------------------------------------------------------------------
// Indian Classical Music Synesthesia Graph
// -----------------------------------------------------------------------------

model Raga {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String            @unique
  melakartaNumber Int?
  arohana         String            // Ascending scale (e.g. S R₂ G₃ M₁ P D₂ N₃ Ṡ)
  avarohana       String            // Descending scale
  deity           String?
  rasa            String?           // Bhakti, Shanta, Karuna, etc.
  timeOfDay       String?
  description     String?           @db.Text
  embedding       Unsupported("vector(1536)")?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  compositions    Composition[]
  artworkLinks    ArtworkRagaLink[]

  @@map("ragas")
}

model Composition {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  ragaId      String    @db.Uuid
  tala        String    // Adi, Rupaka, etc.
  composer    String    // Tyagaraja, Dikshitar, etc.
  vocalist    String    @default("Lalita Kapilavai")
  audioUrl    String
  lyrics      String?   @db.Text
  translation String?   @db.Text
  duration    Int       // seconds
  recordedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  raga        Raga      @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@map("compositions")
}

model ArtworkRagaLink {
  artworkId   String   @db.Uuid
  ragaId      String   @db.Uuid
  harmonyNote String?  @db.Text
  createdAt   DateTime @default(now())

  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  raga        Raga     @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@id([artworkId, ragaId])
  @@map("artwork_raga_links")
}

// -----------------------------------------------------------------------------
// Events, Workshops, Exhibitions & Concerts
// -----------------------------------------------------------------------------

enum EventType {
  WORKSHOP
  ONLINE_CLASSROOM
  EXHIBITION
  CONCERT
  RECITAL
  PRIVATE_VIEWING
  OTHER
}

model Event {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String              @unique
  eventType          EventType
  description        String              @db.Text
  venue              String
  venueName          String?
  streetAddress      String?
  city               String
  stateProvince      String?
  postalCode         String?
  country            String              @default("India")
  countryCode        String?
  timezone           String              @default("Asia/Kolkata")
  startDate          DateTime
  endDate            DateTime?
  posterUrl          String?
  bannerImage        String?
  galleryImages      Json?
  brochurePdfUrl        String?
  brochureTitle         String?             @default("Exhibition Monograph & Program Brochure")
  brochureDownloadable  Boolean             @default(true)
  galleryDisplayMode    String?             @default("CAROUSEL") // "CAROUSEL" | "SCROLL" | "COLLAGE"
  galleryAutoplayTimer  Int?                @default(4)
  maxCapacity        Int?
  registrationFee    Decimal?            @db.Decimal(10, 2)
  currency           String              @default("INR")
  isRegistrationOpen Boolean             @default(true)
  isPublished        Boolean             @default(true)
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  artworks           ArtworkOnEvent[]
  registrations      EventRegistration[]
  leads              Lead[]
  eCatalogs          ECatalog[]

  @@map("events")
}

model EventRegistration {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId       String   @db.Uuid
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  ticketCount   Int      @default(1)
  paymentStatus String   @default("CONFIRMED")
  registeredAt  DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_registrations")
}

// -----------------------------------------------------------------------------
// Inbound Leads CRM (Web Forms & Physical QR Scans)
// -----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUALIFIED
  CLOSED
  ARCHIVED
}

model Lead {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  email           String
  phone           String?
  subject         String?
  message         String      @db.Text
  status          LeadStatus  @default(NEW)
  formTitle       String?     // e.g. "General Contact", "Private Viewing RSVP", "Commission Request"
  pageSlug        String?     // e.g. "contact", "about-me", "home"
  source          String      @default("PAGE_FORM") // "PAGE_FORM", "QR_SCAN", "EVENT_RSVP"
  customFields    Json?       // Key-value store of dynamic fields
  sourceArtworkId String?     @db.Uuid // Linked artwork for physical exhibition QR scans or direct inquiries
  sourceEventId   String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sourceArtwork   Artwork?    @relation(fields: [sourceArtworkId], references: [id], onDelete: SetNull)
  sourceEvent     Event?      @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@map("leads")
}

// -----------------------------------------------------------------------------
// SEO / AEO Optimized Blog Posts
// -----------------------------------------------------------------------------

model BlogPost {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  slug             String    @unique
  excerpt          String    @db.Text
  content          String    @db.Text
  featuredImageUrl String?
  author           String    @default("Lalita Kapilavai")
  tags             String[]
  metaTitle        String?
  metaDescription  String?
  structuredJsonLd Json?     // Structured Schema.org Article / BreadcrumbList JSON-LD
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("blog_posts")
}

// -----------------------------------------------------------------------------
// Customizable Admin Dashboard Widgets
// -----------------------------------------------------------------------------

model DashboardWidget {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  widgetType  String   // "STAT_CARD", "QUICK_LINK", "SYSTEM_STATUS", "CUSTOM_HTML"
  metricValue String?
  metricSub   String?
  targetUrl   String?
  iconName    String?  // Lucide icon identifier
  order       Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dashboard_widgets")
}

// -----------------------------------------------------------------------------
// Digital Exhibition e-Catalogs & Booklets
// -----------------------------------------------------------------------------

model ECatalog {
  id                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String         @unique
  subtitle           String?
  curatorNote        String?        @db.Text
  curatorialEssay    String?        @db.Text
  forewordBy         String?
  coverImage         String?
  coverImageUrl      String?
  pdfUrl             String?        // Optional pre-compiled static PDF asset
  downloadablePdfUrl String?
  themeColor         String         @default("gold")
  orientation        String         @default("portrait") // "portrait" | "landscape"
  plateLayout        String         @default("SIDE_BY_SIDE") // "SIDE_BY_SIDE" | "STACKED"

  // Global Catalog Theme & Framing
  // { backgroundColor, textColor, frameStyle: "none"|"gold-fillet"|"double-fillet"|"silk-border", accentColor }
  themeConfig        Json?

  // Page-Specific Customizations
  // { backgroundColor, backgroundImage, frameStyle, showDate, showCurator, subtitle }
  coverConfig        Json?
  // { title, contentHtml, backgroundImage, backgroundColor, frameStyle }
  essayConfig        Json?
  // { isEnabled: boolean, title, contentHtml, backgroundImage, backgroundColor, frameStyle, contactDetails }
  endPageConfig      Json?

  // Linked Event / Exhibition (Optional)
  eventId            String?        @db.Uuid
  event              Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Custom Introductory Sections (Cover, Preface, Artist Bio, Colophon)
  // Stored as JSON array: [{ id: string, title: string, contentHtml: string, orderIndex: number }]
  introSections      Json?

  // Custom Editorial & Magazine Pages
  customPages        ECatalogCustomPage[]

  // Curated Artworks Selection
  items              ECatalogItem[]

  isPublished        Boolean        @default(false)
  downloadEnabled    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("e_catalogs")
}

model ECatalogCustomPage {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  catalogId         String    @db.Uuid
  catalog           ECatalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  pageNumber        Int       @default(1)
  title             String?   // e.g. "Sacred Iconography & Nayaka Influence"
  subtitle          String?   // e.g. "Scholarly commentary and dynastic patronage"
  layoutType        String    @default("2_COL") // "1_COL" | "2_COL" | "3_COL" | "4_COL" | "6_COL" | "ASYMMETRIC_70_30" | "ASYMMETRIC_30_70"
  pageLayout        String?   @default("2_COL") // backward compatible alias
  contentHtml       String?   @db.Text
  sections          Json?     // Optional structured blocks
  segments          Json?     // Array of segment objects: [{ id, title, contentHtml, image, caption, widthRatio }]

  // Matrix & Layout Definition
  matrixRows        Int       @default(2)
  matrixCols        Int       @default(2)
  rowHeights        String?   @default("1fr 1fr")
  colWidths         String?   @default("1fr 1fr")
  hasHeader         Boolean   @default(false)
  headerHtml        String?   @db.Text
  hasFooter         Boolean   @default(false)
  footerHtml        String?   @db.Text
  verticalSpineMode String    @default("NONE") // "NONE" | "LEFT" | "RIGHT"
  verticalSpineHtml String?   @db.Text
  verticalSpineWidth String?  @default("25%")

  // Background Styling Suite
  backgroundType    String    @default("COLOR") // "COLOR" | "PATTERN" | "IMAGE"
  backgroundColor   String?   @default("#FAF7F2")
  backgroundPattern String?
  patternOpacity    Float?    @default(0.15)
  backgroundImage   String?
  overlayOpacity    Float?    @default(0.2)
  frameStyle        String?   @default("gold-fillet")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("e_catalog_custom_pages")
}

model ECatalogTemplate {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  description        String?
  targetPageType     String    @default("MAGAZINE") // "COVER" | "MAGAZINE" | "END_PAGE"
  matrixRows         Int       @default(2)
  matrixCols         Int       @default(2)
  rowHeights         String?   @default("1fr 1fr")
  colWidths          String?   @default("1fr 1fr")
  hasHeader          Boolean   @default(false)
  headerHtml         String?   @db.Text
  hasFooter          Boolean   @default(false)
  footerHtml         String?   @db.Text
  verticalSpineMode  String    @default("NONE") // "NONE" | "LEFT" | "RIGHT"
  verticalSpineHtml  String?   @db.Text
  verticalSpineWidth String?   @default("25%")
  segments           Json?     // Skeleton matrix segments [{ row, col, rowSpan, colSpan, title, contentHtml }]
  frameStyle         String?   @default("gold-fillet")
  backgroundType     String?   @default("COLOR")
  backgroundColor    String?   @default("#FAF7F2")
  backgroundPattern  String?
  patternOpacity     Float?    @default(0.15)
  backgroundImage    String?
  overlayOpacity     Float?    @default(0.2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("e_catalog_templates")
}

model ECatalogItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  catalogId      String   @db.Uuid
  catalog        ECatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  artworkId      String   @db.Uuid
  artwork        Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  orderIndex     Int      @default(0)
  pageNumber     Int      @default(1)
  customNote     String?  @db.Text
  curatorialNote String?  @db.Text
  highlightPlate Boolean  @default(false)
  plateLayout    String?  // Optional per-plate override: "SIDE_BY_SIDE" | "STACKED"
  customTitle    String?  // Custom page heading (defaults to artwork title)
  customSubtitle String?  // Custom subheading/tagline (defaults to category/school)
  showPlateNumber Boolean @default(true) // Toggle for "Plate X of Y" badge

  @@unique([catalogId, artworkId])
  @@map("e_catalog_items")
}
