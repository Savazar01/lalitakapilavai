// Prisma Schema for Lalita Kapilavai Portfolio & Cultural Archive Platform
// Configured with PostgreSQL 17, pgvector, RBAC, Dynamic Layouts & Cultural Graph

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// RBAC & Better-Auth Models
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(ADMIN)
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// -----------------------------------------------------------------------------
// Global System Configuration & Storage
// -----------------------------------------------------------------------------

model SystemSetting {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  siteName          String   @default("Lalita Kapilavai — Sacred Art & Carnatic Music Archive")
  siteDescription   String?  @db.Text
  adminAlertEmail   String   @default("admin@lalitakapilavai.com")
  contactEmail      String?
  contactPhone      String?
  
  // Watermark parameters
  watermarkText     String   @default("© Lalita Kapilavai - Sacred Art & Heritage")
  watermarkOpacity  Float    @default(0.4)
  watermarkFontSize Int      @default(32)

  // Cloudflare R2 / AWS S3 storage settings
  storageProvider   String   @default("R2") // R2, S3, CUSTOM
  r2AccountId       String?
  r2BucketName      String?  @default("lalitakapilavai-media")
  r2PublicUrl       String?  @default("https://media.lalitakapilavai.com")
  s3Region          String?  @default("ap-south-1")
  s3BucketName      String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3PublicUrl       String?
  
  // Localization defaults
  defaultCurrency   String   @default("INR")
  defaultTimezone   String   @default("Asia/Kolkata")

  instagramUrl      String?
  youtubeUrl        String?
  facebookUrl       String?
  pinterestUrl      String?
  // Branding
  logoUrl           String?
  faviconUrl        String?

  // Dynamic Footer, Email/Gmail SMTP & Multi-Provider AI Configuration
  footerConfig      Json?
  emailConfig       Json?
  aiConfig          Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// Dynamic Navigation (Menu Items)
// -----------------------------------------------------------------------------

enum MenuPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  SIDEBAR_LEFT
  DRAWER_RIGHT
}

model MenuItem {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label        String
  path         String
  position     MenuPosition  @default(TOP_CENTER)
  orderIndex   Int           @default(0)
  isActive     Boolean       @default(true)
  openInNewTab Boolean       @default(false)
  iconName     String?

  // Self-referencing hierarchy supporting up to 2 nested sub-menu tiers
  parentId     String?       @db.Uuid
  parent       MenuItem?     @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]    @relation("MenuHierarchy")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("menu_items")
}

// -----------------------------------------------------------------------------
// Dynamic Page Layout Engine (12-Column Responsive Grid)
// -----------------------------------------------------------------------------

model Page {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  slug            String        @unique
  metaDescription String?       @db.Text
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections        PageSection[]

  @@map("pages")
}

model PageSection {
  id                       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pageId                   String        @db.Uuid
  title                    String?
  slug                     String?
  orderIndex               Int           @default(0)
  gridSpan                 Int           @default(12) // 1 to 12 responsive grid span
  backgroundColor          String?
  backgroundType           String?       @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?        @default(0.5)
  customCssClass           String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  page                     Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  subSections              SubSection[]

  @@map("page_sections")
}

model SubSection {
  id                       String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sectionId                String      @db.Uuid
  title                    String?
  orderIndex               Int         @default(0)
  gridSpan                 Int         @default(12) // 1 to 12 responsive grid span
  content                  Json        // Rich block JSON content
  backgroundType           String?     @default("COLOR") // COLOR, PATTERN, IMAGE
  backgroundPattern        String?
  backgroundImage          String?
  backgroundOverlayOpacity  Float?      @default(0.5)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  section                  PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("sub_sections")
}

// -----------------------------------------------------------------------------
// Artwork Catalog, Categories & Exhibitions
// -----------------------------------------------------------------------------

model ArtCategory {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String    @unique // Tanjore, Mysore, Pahari, Pichwai, Kalamkari, Cheriyal, Miscellaneous
  slug         String    @unique
  description  String?   @db.Text
  coverImage   String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artworks     Artwork[]

  @@map("art_categories")
}

model Artwork {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String               @unique
  description        String               @db.Text
  categoryId         String               @db.Uuid
  dimensions         String               // e.g. "36 x 48 inches"
  medium             String               // e.g. "22k Gold Foil, Teakwood, Semi-Precious Gemstones"
  yearCreated        Int
  hasGoldFoil        Boolean              @default(false)
  goldPurity         String?              // e.g. "22 Carat Jaipur Gold Leaf"
  price              Decimal?             @db.Decimal(12, 2)
  currency           String               @default("INR")
  isAvailable        Boolean              @default(true)
  isFeatured         Boolean              @default(false)
  primaryImageUrl    String
  watermarkedWebpUrl String
  protectedS3Key     String?              // Protected original master S3 key
  qrCodeUrl          String?              // Generated high-res Exhibition Floor QR code URL
  
  // 1536-dimensional embedding for pgvector visual similarity
  embedding          Unsupported("vector(1536)")?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  category           ArtCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events             ArtworkOnEvent[]
  leads              Lead[]
  ragaLinks          ArtworkRagaLink[]

  @@map("artworks")
}

model ArtworkOnEvent {
  artworkId    String   @db.Uuid
  eventId      String   @db.Uuid
  displayOrder Int      @default(0)

  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([artworkId, eventId])
  @@map("artworks_on_events")
}

// -----------------------------------------------------------------------------
// Indian Classical Music Synesthesia Graph
// -----------------------------------------------------------------------------

model Raga {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String            @unique
  melakartaNumber Int?
  arohana         String            // Ascending scale (e.g. S R₂ G₃ M₁ P D₂ N₃ Ṡ)
  avarohana       String            // Descending scale
  deity           String?
  rasa            String?           // Bhakti, Shanta, Karuna, etc.
  timeOfDay       String?
  description     String?           @db.Text
  embedding       Unsupported("vector(1536)")?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  compositions    Composition[]
  artworkLinks    ArtworkRagaLink[]

  @@map("ragas")
}

model Composition {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  ragaId      String    @db.Uuid
  tala        String    // Adi, Rupaka, etc.
  composer    String    // Tyagaraja, Dikshitar, etc.
  vocalist    String    @default("Lalita Kapilavai")
  audioUrl    String
  lyrics      String?   @db.Text
  translation String?   @db.Text
  duration    Int       // seconds
  recordedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  raga        Raga      @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@map("compositions")
}

model ArtworkRagaLink {
  artworkId   String   @db.Uuid
  ragaId      String   @db.Uuid
  harmonyNote String?  @db.Text
  createdAt   DateTime @default(now())

  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  raga        Raga     @relation(fields: [ragaId], references: [id], onDelete: Cascade)

  @@id([artworkId, ragaId])
  @@map("artwork_raga_links")
}

// -----------------------------------------------------------------------------
// Events, Workshops, Exhibitions & Concerts
// -----------------------------------------------------------------------------

enum EventType {
  WORKSHOP
  ONLINE_CLASSROOM
  EXHIBITION
  CONCERT
  RECITAL
  PRIVATE_VIEWING
  OTHER
}

model Event {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String
  slug               String              @unique
  eventType          EventType
  description        String              @db.Text
  venue              String
  venueName          String?
  streetAddress      String?
  city               String
  stateProvince      String?
  postalCode         String?
  country            String              @default("India")
  countryCode        String?
  timezone           String              @default("Asia/Kolkata")
  startDate          DateTime
  endDate            DateTime?
  posterUrl          String?
  bannerImage        String?
  galleryImages      Json?
  maxCapacity        Int?
  registrationFee    Decimal?            @db.Decimal(10, 2)
  currency           String              @default("INR")
  isRegistrationOpen Boolean             @default(true)
  isPublished        Boolean             @default(true)
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  artworks           ArtworkOnEvent[]
  registrations      EventRegistration[]
  leads              Lead[]

  @@map("events")
}

model EventRegistration {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId       String   @db.Uuid
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  ticketCount   Int      @default(1)
  paymentStatus String   @default("CONFIRMED")
  registeredAt  DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_registrations")
}

// -----------------------------------------------------------------------------
// Inbound Leads CRM (Web Forms & Physical QR Scans)
// -----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUALIFIED
  CLOSED
  ARCHIVED
}

model Lead {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  email           String
  phone           String?
  subject         String?
  message         String      @db.Text
  status          LeadStatus  @default(NEW)
  sourceArtworkId String?     @db.Uuid // Linked artwork for physical exhibition QR scans or direct inquiries
  sourceEventId   String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sourceArtwork   Artwork?    @relation(fields: [sourceArtworkId], references: [id], onDelete: SetNull)
  sourceEvent     Event?      @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@map("leads")
}

// -----------------------------------------------------------------------------
// SEO / AEO Optimized Blog Posts
// -----------------------------------------------------------------------------

model BlogPost {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String
  slug             String    @unique
  excerpt          String    @db.Text
  content          String    @db.Text
  featuredImageUrl String?
  author           String    @default("Lalita Kapilavai")
  tags             String[]
  metaTitle        String?
  metaDescription  String?
  structuredJsonLd Json?     // Structured Schema.org Article / BreadcrumbList JSON-LD
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("blog_posts")
}

// -----------------------------------------------------------------------------
// Customizable Admin Dashboard Widgets
// -----------------------------------------------------------------------------

model DashboardWidget {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  widgetType  String   // "STAT_CARD", "QUICK_LINK", "SYSTEM_STATUS", "CUSTOM_HTML"
  metricValue String?
  metricSub   String?
  targetUrl   String?
  iconName    String?  // Lucide icon identifier
  order       Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dashboard_widgets")
}
