# ==============================================================================
# Lalita Kapilavai Portfolio & Archive Platform - Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3060
PORT=3060

# ------------------------------------------------------------------------------
# PostgreSQL Database with pgvector (Custom Port: 5633)
# ------------------------------------------------------------------------------
# Local development connection string (docker-compose.dev.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5633/lalitakapilavai_dev?schema=public"

# Docker container network connection string (docker-compose.yml)
# DATABASE_URL="postgresql://postgres:postgres@db:5432/lalitakapilavai_prod?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lalitakapilavai_dev

# ------------------------------------------------------------------------------
# Authentication (Better-Auth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="generate-a-32-char-random-secret-key-for-auth"
BETTER_AUTH_URL="http://localhost:3060"

# Admin Initial Credentials
ADMIN_EMAIL="admin@lalitakapilavai.com"
ADMIN_INITIAL_PASSWORD="AdminPassword2026!"

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3-Compatible Object Storage
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="lalitakapilavai-media"
R2_PUBLIC_URL="https://media.lalitakapilavai.com"

# AWS S3 Fallback / Backup
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ------------------------------------------------------------------------------
# Image Watermarking & Dynamic Media Protection
# ------------------------------------------------------------------------------
WATERMARK_TEXT="© Lalita Kapilavai - All Rights Reserved"
MEDIA_CACHE_TTL="31536000" # 1 year in seconds
