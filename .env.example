# ==============================================================================
# SavazAI WebApps Platform - Environment Configuration Template
# ==============================================================================

# Application Environment & Branding
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="SavazAI WebApps Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3060
PORT=3060

# Container & Infrastructure Standardization
CONTAINER_WEB_NAME="savazai_web_dev"
CONTAINER_DB_NAME="savazai_postgres_dev"
IMAGE_NAME="savazai-web-dev:latest"

# ------------------------------------------------------------------------------
# PostgreSQL Database with pgvector (Custom Port: 5633 in Dev)
# ------------------------------------------------------------------------------
# Local development connection string (docker-compose.dev.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5633/savazai_webapps_dev?schema=public"

# Production container network connection string (docker-compose.yml / Coolify)
# DATABASE_URL="postgresql://postgres:postgres@savazai_postgres:5432/savazai_webapps_prod?schema=public"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=savazai_webapps_dev

# ------------------------------------------------------------------------------
# Authentication (Better-Auth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="generate-a-32-char-random-secret-key-for-auth"
BETTER_AUTH_URL="http://localhost:3060"

# Admin Initial Bootstrap Credentials (Override in production)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="AdminPassword2026!"

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3-Compatible Object Storage
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="savazai-media"
R2_PUBLIC_URL="https://media.yourdomain.com"

# AWS S3 Fallback / Multi-Region Backup
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ------------------------------------------------------------------------------
# Image Watermarking & Dynamic Media Protection
# ------------------------------------------------------------------------------
WATERMARK_TEXT="© SavazAI WebApps Platform - Archival Masterwork Protection"
MEDIA_CACHE_TTL="31536000" # 1 year in seconds

# ------------------------------------------------------------------------------
# Fixture Packs & Multi-Tenant Seeding Flag
# Options: "generic" (default neutral setup) | "lalita" (traditional art archive)
# ------------------------------------------------------------------------------
TENANT_FIXTURE_PACK="generic"
